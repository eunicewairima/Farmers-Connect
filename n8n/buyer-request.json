    {
      "name": "Validate form",
      "id": "Validate form",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const farmer = false;\nconst body = $json.body ?? {};\nconst row = {};\nconst validPhone = /^\\+(?:254[17][0-9]{8}|(?!254)[1-9][0-9]{7,14})$/;\nconst validEmail = /^[a-z0-9.!#$%&'*+/=?^_\\x60{|}~-]+@[a-z0-9-]+(?:\\.[a-z0-9-]+)+$/i;\nconst validReference = /^[a-f0-9]{8}-[a-f0-9]{4}-4[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$/;\nconst today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Africa/Nairobi' }).format(new Date());\n\nfunction readText(source, key, max, required = true) {\n    const value = typeof source?.[key] === 'string' ? source[key].trim() : '';\n    if ((required && !value) || value.length > max) throw new Error('Invalid ' + key);\n    return value;\n}\n\nfunction date(source, key) {\n    const value = readText(source, key, 10);\n    const parsed = new Date(value + 'T00:00:00Z');\n    if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(value) || !Number.isFinite(+parsed) ||\n        parsed.toISOString().slice(0, 10) !== value) throw new Error('Invalid ' + key);\n    return value;\n}\n\ntry {\n    row.reference = readText(body, 'reference', 36);\n    row[farmer ? 'farmerName' : 'buyerName'] = readText(body, farmer ? 'farmerName' : 'buyerName', 120);\n    row.phone = readText(body, 'phone', 16);\n    row.location = readText(body, 'location', 150);\n    if (!validReference.test(row.reference) || !validPhone.test(row.phone) || body.dataConsent !== 'true') {\n        throw new Error('Invalid reference, phone, or consent');\n    }\n    row.dataConsent = true;\n    if (!farmer) {\n        row.email = readText(body, 'email', 254);\n        row.notes = readText(body, 'notes', 1000, false);\n        row.preferredDeliveryDate = date(body, 'preferredDeliveryDate');\n        if (!validEmail.test(row.email) || row.preferredDeliveryDate < today) throw new Error('Invalid email or delivery date');\n    }\n\n    const entries = JSON.parse(readText(body, 'items', 16000));\n    if (!Array.isArray(entries) || entries.length < 1 || entries.length > 20) throw new Error('Invalid item count');\n    const items = entries.map((item) => {\n        const produce = readText(item, 'produce', 100);\n        const quantityKg = item.quantityKg;\n        if (typeof quantityKg !== 'number' || quantityKg < 0.01 || quantityKg > 1000000 ||\n            quantityKg !== Math.round(quantityKg * 100) / 100) throw new Error('Invalid quantity');\n        return { produce, quantityKg, ...(farmer && { harvestDate: date(item, 'harvestDate') }) };\n    });\n    row.items = JSON.stringify(items);\n    row.produce = items.map((item) => item.produce).join(', ');\n    row.itemDetails = items.map((item) => item.produce + ' — ' + item.quantityKg + ' kg' +\n        (farmer ? ', harvest ' + item.harvestDate : '')).join('\\n');\n    row.submittedAt = new Date().toISOString();\n    row.status = farmer ? 'Pending review' : 'New';\n    return { valid: true, row };\n} catch {\n    return { valid: false };\n}"
      }
